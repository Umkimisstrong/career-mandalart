{
  "name": "gudo-desktop",
  "productName": "구도 GUDO",
  "version": "1.3.1",
  "description": "구도 GUDO · Nine Ways — Windows 데스크톱 앱 (바탕화면 작은 창)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --url=http://localhost:8090 --profile=.dev-profile",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish never && node release.cjs",
    "dist:store": "node store.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.gudo.desktop",
    "productName": "GUDO",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "GUDO-Setup.${ext}"
    },
    "appx": {
      "identityName": "GUDO.GUDO",
      "publisher": "CN=53F97BE0-FD21-4431-9BE7-367003B99782",
      "publisherDisplayName": "GUDO",
      "displayName": "구도 GUDO",
      "applicationId": "GUDO",
      "backgroundColor": "#0B1026",
      "languages": ["ko-KR", "en-US"],
      "artifactName": "GUDO-Store.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "구도 GUDO"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Umkimisstrong/career-mandalart/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
