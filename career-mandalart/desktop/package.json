{
  "name": "gudo-desktop",
  "productName": "구도 GUDO",
  "version": "1.2.1",
  "description": "구도 GUDO · Nine Ways — Windows 데스크톱 앱 (바탕화면 작은 창)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --url=http://localhost:8090 --profile=.dev-profile",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish never && node release.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.gudo.desktop",
    "productName": "GUDO",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "GUDO-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "구도 GUDO"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Umkimisstrong/career-mandalart/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
